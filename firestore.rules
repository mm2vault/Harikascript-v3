rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email in [
          'huseynoveleddin87@gmail.com',
          'mm2ultimatehub@gmail.com'
        ] && request.auth.token.firebase.sign_in_provider == 'google.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Client profile edits must never change economy, progression, ownership,
    // account role, or moderation state. Those fields need trusted server logic.
    function isSafeUserProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let inventory = resource.data.get('inventory', []);
      return changed.hasOnly([
        'username', 'robloxUsername', 'avatarUrl', 'bio', 'bannerColor',
        'equippedFrameId', 'equippedAvatarId', 'equippedEffectId',
        'equippedBadges', 'soundEnabled'
      ])
      && (!changed.hasAny(['username']) ||
        (request.resource.data.username is string
          && request.resource.data.username.size() >= 2
          && request.resource.data.username.size() <= 32))
      && (!changed.hasAny(['robloxUsername']) ||
        (request.resource.data.robloxUsername is string
          && request.resource.data.robloxUsername.size() <= 32))
      && (!changed.hasAny(['bio']) ||
        (request.resource.data.bio is string
          && request.resource.data.bio.size() <= 500))
      && (!changed.hasAny(['avatarUrl']) ||
        (request.resource.data.avatarUrl is string
          && request.resource.data.avatarUrl.size() <= 500000))
      && (!changed.hasAny(['bannerColor']) ||
        (request.resource.data.bannerColor is string
          && request.resource.data.bannerColor.size() <= 120))
      && (!changed.hasAny(['soundEnabled']) ||
        request.resource.data.soundEnabled is bool)
      && (request.resource.data.get('equippedFrameId', '') == ''
        || request.resource.data.get('equippedFrameId', '') in inventory)
      && (request.resource.data.get('equippedAvatarId', '') == ''
        || request.resource.data.get('equippedAvatarId', '') in inventory)
      && (request.resource.data.get('equippedEffectId', '') == ''
        || request.resource.data.get('equippedEffectId', '') in inventory)
      && request.resource.data.get('equippedBadges', []).hasOnly(inventory);
    }

    function isDirectMessageParticipant(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/direct_messages/$(roomId))
        && request.auth.uid in get(/databases/$(database)/documents/direct_messages/$(roomId)).data.participantUids;
    }

    // Admin grants cannot be created by ordinary clients.
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Public content is readable; only admins may manage shared catalogue data.
    match /scripts/{scriptId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorRole == 'Community'
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorRole == resource.data.authorRole
      );
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.authorUid == request.auth.uid
      );
    }

    match /games/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /executors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mm2_items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blox_fruits/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tasks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cosmetics/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promo_codes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /songs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mystery_cases/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /value_categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /value_items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /system_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A profile is private to its owner and administrators. Owners cannot grant
    // themselves admin/banned status by editing the client-side profile object.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && (
          (
            request.resource.data.role == 'user'
            && request.resource.data.get('coins', -1) == 200
            && request.resource.data.get('xp', -1) == 0
            && request.resource.data.get('level', -1) == 1
            && request.resource.data.get('inventory', ['invalid']).size() == 0
            && request.resource.data.get('unlockedScriptIds', ['invalid']).size() == 0
            && request.resource.data.get('completedTaskIds', ['invalid']).size() == 0
            && request.resource.data.get('equippedBadges', ['invalid']).size() == 0
            && request.resource.data.get('isBanned', true) == false
            && request.resource.data.get('banReason', 'invalid') == ''
          )
          || (isAdmin() && request.resource.data.role == 'admin')
        );
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false)
        && request.resource.data.get('banReason', '') == resource.data.get('banReason', '')
        && isSafeUserProfileUpdate()
      );
      allow delete: if isAdmin();
    }

    // Global chat is public to read, but only authenticated accounts can post
    // under their own identity. Admin badges are checked against auth claims.
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.isAdmin == isAdmin()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.timestamp is string;
      allow update, delete: if isAdmin() || (
        isSignedIn()
        && resource.data.senderUid == request.auth.uid
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.senderEmail == resource.data.senderEmail
        && request.resource.data.isAdmin == resource.data.isAdmin
      );
    }

    // DM room IDs contain the two Firebase UIDs; a user must be one of those
    // participants to create/read the room or its messages.
    match /direct_messages/{roomId} {
      allow create: if isSignedIn()
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && (
          roomId.matches('^dm_' + request.auth.uid + '_.*')
          || roomId.matches('^dm_.*_' + request.auth.uid + '$')
        );
      allow read: if isAdmin() || (
        isSignedIn()
        && resource.data.participantUids is list
        && request.auth.uid in resource.data.participantUids
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.participantUids is list
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.participantEmails == resource.data.participantEmails
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || isDirectMessageParticipant(roomId);
        allow create: if isDirectMessageParticipant(roomId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email
          && request.resource.data.isAdmin == isAdmin();
        allow update, delete: if isAdmin() || (
          isDirectMessageParticipant(roomId)
          && resource.data.senderUid == request.auth.uid
        );
      }
    }

    // Trade posts are public to browse but must be owned by the authenticated
    // account that creates or edits them.
    match /trade_posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn()
        && request.resource.data.authorEmail == request.auth.token.email);
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.authorEmail == request.auth.token.email
        && request.resource.data.authorEmail == resource.data.authorEmail
      );
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.authorEmail == request.auth.token.email
      );
    }

    // Reports contain personal contact information and are only visible to admins.
    match /user_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.status == 'Beklemede'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }

    // Audit logs can be submitted by authenticated app actions, but only admins
    // may inspect or modify the log collection.
    match /audit_logs/{logId} {
      // Client-forged admin audit entries are not trusted.
      allow create, read, update, delete: if isAdmin();
    }

    // A read-only connectivity probe; clients must not be able to write test data.
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}